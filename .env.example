# ===== LLM（OpenAI 兼容接口，DeepSeek / SiliconFlow 等均可）=====
OPENAI_API_KEY=sk-your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ===== Flask 会话签名密钥 =====
# 开发环境：留空或占位值时自动生成并持久化到 data/.flask_secret_key（重启不失效）
# 生产环境（APP_ENV=production）：必须显式配置 ≥32 位随机强密钥，否则拒绝启动
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-string

# ===== 运行环境 =====
# dev（默认）| production。生产模式：禁止默认管理员口令（改用 ADMIN_INITIAL_PASSWORD
# 或随机生成）、拒绝弱密钥启动、禁止 python web_app.py 开发服务器方式运行
APP_ENV=dev
# 仅生产环境首次建库时读取（需满足口令策略）；不配置则随机生成并打印一次
# ADMIN_INITIAL_PASSWORD=

# ===== 博查联网搜索（旅行规划的实时信息，https://open.bochaai.com）=====
BOCHA_API_KEY=sk-your_bocha_api_key_here

# ===== LangSmith 轨迹观测（可选：smith.langchain.com 免费注册拿 key）=====
# 填好后重启服务，LangChain/LangGraph 的每次 LLM 调用与工具轨迹自动上报
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
# LANGSMITH_PROJECT=airline-customer-agent

# ===== Langfuse 轨迹观测（可选：自建 docker compose up -d 后启用）=====
# 一键启动 Langfuse UI：项目根目录执行 docker compose up -d（langfuse-web 端口 3000）
# 进入 http://localhost:3000 注册、创建 Project、把 Project 的 Public Key / Secret Key 填到这里。
# 与 LangSmith 并存：两者都填则两套观测同时生效；不填则 Langfuse 链路自动降级为 no-op。
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_HOST=http://localhost:3000

# ===== HTTP 超时（秒，可选）=====
HTTP_TIMEOUT=30

# ===== 支付渠道 =====
# mock（默认，站内一步付讫，无需任何凭据）
# alipay_sandbox（支付宝沙箱）/ alipay（生产，需签约）
PAY_PROVIDER=mock

# 支付宝：沙箱凭据从 https://open.alipay.com/develop/sandbox/app 获取
# 密钥文件放 keys/ 下（见 keys/README.md），私钥与支付宝公钥均不入库
ALIPAY_APP_ID=
ALIPAY_DEBUG=true
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_PRIVATE_KEY_PATH=keys/alipay_private.key
ALIPAY_PUBLIC_KEY_PATH=keys/alipay_public.key

# 回调地址：留空则按当前请求 host 自动拼接（本地开发够用）
# 异步通知必须公网可达，走内网穿透时显式写死更稳妥，例如：
# ALIPAY_NOTIFY_URL=http://flightagent.nat100.top/api/pay/notify/alipay
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# 支付超时（分钟），需与待支付订单自动取消时长一致
PAY_TIMEOUT_MINUTES=15
